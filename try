/**
 * Nuvio Plugin: GitHub YouTube Finder
 * Searches GitHub for YouTube video links related to a TMDB title,
 * then returns them as playable stream objects via youtube-dl-style proxy.
 *
 * Single-file provider (Workflow B) — already transpiled for Hermes compatibility.
 */

"use strict";

// ─── Helpers ────────────────────────────────────────────────────────────────

function httpGet(url, headers) {
  return fetch(url, { headers: headers || {} }).then(function (res) {
    if (!res.ok) throw new Error("HTTP " + res.status + " for " + url);
    return res.json();
  });
}

function httpGetText(url, headers) {
  return fetch(url, { headers: headers || {} }).then(function (res) {
    if (!res.ok) throw new Error("HTTP " + res.status + " for " + url);
    return res.text();
  });
}

// Extract all YouTube video IDs from a block of text
function extractYouTubeIds(text) {
  var ids = [];
  var seen = {};
  // Matches youtu.be/<id>, youtube.com/watch?v=<id>, /embed/<id>, /v/<id>
  var pattern = /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/))([A-Za-z0-9_-]{11})/g;
  var match;
  while ((match = pattern.exec(text)) !== null) {
    var id = match[1];
    if (!seen[id]) {
      seen[id] = true;
      ids.push(id);
    }
  }
  return ids;
}

// Fetch YouTube video title via oEmbed (no API key required)
function getYouTubeTitle(videoId) {
  var oembedUrl =
    "https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=" +
    encodeURIComponent(videoId) +
    "&format=json";
  return fetch(oembedUrl)
    .then(function (res) {
      if (!res.ok) return null;
      return res.json();
    })
    .then(function (data) {
      return data && data.title ? data.title : "YouTube Video";
    })
    .catch(function () {
      return "YouTube Video";
    });
}

// Resolve a YouTube video ID to a direct streamable URL via the Piped API (no key needed)
function resolveYouTubeStream(videoId) {
  // Piped is a privacy-friendly YouTube proxy with a public API
  var pipedUrl = "https://pipedapi.kavin.rocks/streams/" + videoId;
  return fetch(pipedUrl)
    .then(function (res) {
      if (!res.ok) throw new Error("Piped API error: " + res.status);
      return res.json();
    })
    .then(function (data) {
      var streams = [];

      // Collect video streams
      if (data.videoStreams && data.videoStreams.length > 0) {
        var videoStreams = data.videoStreams
          .filter(function (s) {
            return s.url && s.videoOnly === false; // muxed audio+video
          })
          .sort(function (a, b) {
            // Sort by quality descending
            var qa = parseInt(a.quality) || 0;
            var qb = parseInt(b.quality) || 0;
            return qb - qa;
          });

        for (var i = 0; i < Math.min(videoStreams.length, 3); i++) {
          var s = videoStreams[i];
          var qualityLabel = s.quality || "Unknown";
          streams.push({
            name: "GitHub-YT",
            title: (data.title || "YouTube Video") + " • " + qualityLabel,
            url: s.url,
            quality: qualityLabel,
            headers: {
              "User-Agent":
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36",
            },
          });
        }
      }

      // Fallback: HLS manifest if available
      if (streams.length === 0 && data.hls) {
        streams.push({
          name: "GitHub-YT",
          title: (data.title || "YouTube Video") + " • HLS",
          url: data.hls,
          quality: "Auto",
          headers: {},
        });
      }

      return streams;
    });
}

// ─── TMDB → Title ────────────────────────────────────────────────────────────

function getTmdbTitle(tmdbId, mediaType) {
  var endpoint =
    mediaType === "tv"
      ? "https://api.themoviedb.org/3/tv/" + tmdbId
      : "https://api.themoviedb.org/3/movie/" + tmdbId;

  // Use TMDB's public endpoint without key (limited, but works for title lookup)
  // Fallback: use a known free TMDB-compatible API
  var url = endpoint + "?api_key=4ef0d7355d9ffb5151e987764708ce96"; // public demo key
  return fetch(url)
    .then(function (res) {
      if (!res.ok) throw new Error("TMDB fetch failed");
      return res.json();
    })
    .then(function (data) {
      return data.title || data.name || tmdbId;
    })
    .catch(function () {
      return tmdbId; // fallback to ID if title lookup fails
    });
}

// ─── GitHub Search ───────────────────────────────────────────────────────────

function searchGitHubForYouTube(query) {
  // Search GitHub code for YouTube links mentioning the title
  var searchUrl =
    "https://api.github.com/search/code?q=" +
    encodeURIComponent(query + " youtube.com/watch language:markdown") +
    "&per_page=10";

  return httpGet(searchUrl, {
    Accept: "application/vnd.github+json",
    "User-Agent": "NuvioPlugin/1.0",
  })
    .then(function (data) {
      if (!data.items || data.items.length === 0) return [];

      // Fetch raw content of top results and extract YouTube IDs
      var fetches = data.items.slice(0, 5).map(function (item) {
        return httpGetText(item.url.replace("https://api.github.com", "https://raw.githubusercontent.com").replace("/repos/", "/").replace("/contents/", "/").replace(/\?.*$/, ""))
          .catch(function () {
            // Fallback: use the GitHub API raw URL
            return httpGetText(
              "https://raw.githubusercontent.com/" +
                item.repository.full_name +
                "/HEAD/" +
                item.path
            ).catch(function () {
              return "";
            });
          });
      });

      return Promise.all(fetches).then(function (texts) {
        var allIds = [];
        var seen = {};
        texts.forEach(function (text) {
          extractYouTubeIds(text).forEach(function (id) {
            if (!seen[id]) {
              seen[id] = true;
              allIds.push(id);
            }
          });
        });
        return allIds;
      });
    })
    .catch(function (err) {
      console.log("[GitHub-YT] GitHub search error: " + err.message);
      return [];
    });
}

// Also do a direct GitHub search via the search/repositories endpoint
function searchGitHubReposForYouTube(query) {
  var searchUrl =
    "https://api.github.com/search/repositories?q=" +
    encodeURIComponent(query + "+youtube") +
    "&per_page=5&sort=stars";

  return httpGet(searchUrl, {
    Accept: "application/vnd.github+json",
    "User-Agent": "NuvioPlugin/1.0",
  })
    .then(function (data) {
      if (!data.items || data.items.length === 0) return [];
      var readmeFetches = data.items.slice(0, 3).map(function (repo) {
        return httpGetText(
          "https://raw.githubusercontent.com/" + repo.full_name + "/HEAD/README.md"
        ).catch(function () {
          return "";
        });
      });
      return Promise.all(readmeFetches).then(function (texts) {
        var allIds = [];
        var seen = {};
        texts.forEach(function (text) {
          extractYouTubeIds(text).forEach(function (id) {
            if (!seen[id]) {
              seen[id] = true;
              allIds.push(id);
            }
          });
        });
        return allIds;
      });
    })
    .catch(function () {
      return [];
    });
}

// ─── Main Entry Point ────────────────────────────────────────────────────────

function getStreams(tmdbId, mediaType, season, episode) {
  console.log(
    "[GitHub-YT] getStreams called: tmdbId=" +
      tmdbId +
      " type=" +
      mediaType +
      " s=" +
      season +
      " e=" +
      episode
  );

  return getTmdbTitle(tmdbId, mediaType)
    .then(function (title) {
      console.log("[GitHub-YT] Resolved title: " + title);

      var query = title;
      if (mediaType === "tv" && season && episode) {
        query += " season " + season + " episode " + episode;
      }

      // Run both GitHub searches in parallel
      return Promise.all([
        searchGitHubForYouTube(query),
        searchGitHubReposForYouTube(title),
      ]).then(function (results) {
        var codeIds = results[0];
        var repoIds = results[1];

        // Merge, deduplicate
        var seen = {};
        var allIds = [];
        codeIds.concat(repoIds).forEach(function (id) {
          if (!seen[id]) {
            seen[id] = true;
            allIds.push(id);
          }
        });

        console.log("[GitHub-YT] Found " + allIds.length + " unique YouTube IDs");

        if (allIds.length === 0) return [];

        // Resolve up to 5 video IDs to streams
        var toResolve = allIds.slice(0, 5);
        return Promise.all(
          toResolve.map(function (id) {
            return resolveYouTubeStream(id).catch(function (err) {
              console.log("[GitHub-YT] Failed to resolve " + id + ": " + err.message);
              return [];
            });
          })
        ).then(function (streamArrays) {
          var finalStreams = [];
          streamArrays.forEach(function (arr) {
            arr.forEach(function (s) {
              finalStreams.push(s);
            });
          });
          console.log("[GitHub-YT] Returning " + finalStreams.length + " streams");
          return finalStreams;
        });
      });
    })
    .catch(function (err) {
      console.log("[GitHub-YT] Fatal error: " + err.message);
      return [];
    });
}

module.exports = { getStreams: getStreams };
